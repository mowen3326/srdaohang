# ============================================================
# 网址导航 环境变量配置模板
# 使用方法：复制本文件为 .env，并按需修改后通过启动脚本运行
#   Windows: copy .env.example .env   然后运行 start.ps1
#   Linux:   cp .env.example .env     然后运行 ./start.sh
# ============================================================

# 监听地址，默认 :8080
ADDR=:8080

# SQLite 数据库文件路径，默认 data/daohang.db
DB_PATH=data/daohang.db

# 会话签名密钥（重要！）
# 生产环境务必设置一个随机长字符串；留空则使用内置默认密钥，
# 会导致任何人都能伪造登录会话。可用以下命令生成随机值：
#   PowerShell: -join ([char[]](48..57+65..90+97..122) | Get-Random -Count 32)
#   Linux:      head -c 32 /dev/urandom | base64
SESSION_SECRET=

# 是否仅通过 HTTPS 下发 Cookie（默认 0；https 部署时建议设为 1）
SECURE_COOKIE=0

# 是否信任反向代理转发头（默认 0）
# 仅当服务部署在 Nginx 等反向代理之后时才设为 1，此时登录日志与限流
# 会使用 X-Forwarded-For 中的真实客户端 IP；直接暴露公网时保持 0，
# 避免攻击者伪造该头绕过登录限流。
TRUST_PROXY=0
